<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.whoamie.soundpilot</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>soundpilot</string>
			</array>
		</dict>
	</array>
	<key>NSAudioCaptureUsageDescription</key>
	<string>SoundPilot needs access to control volume levels for individual applications.</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- Public HTTPS URL for Sparkle's appcast. Must be reachable without auth
	     (private GitHub raw URLs will not work for end users). See guide/distribution.md. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/iamnabink/soundpilot/main/appcast.xml</string>
	<!-- SoundPilot-owned EdDSA public key (private half lives in this Mac's Keychain
	     as "Private key for signing Sparkle updates"). Back it up with:
	     scripts/sparkle-tools.sh export-key -->
	<key>SUPublicEDKey</key>
	<string>4Gfv2Cw/NuiSIrudT29k1rgAci0y7die/SXGYY/EP/U=</string>
</dict>
</plist>
